<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!--
  Modal compartilhado para Deposito e Saque. O Figma so tem uma tela dedicada
  de "Deposito" (Dashboard | Deposito, 3 variantes); nao ha tela de Saque no
  design - por isso este modal reaproveita o mesmo estilo visual do fluxo de
  Transferencia/Deposito para os dois casos, alternando titulo/comando via
  ValorTransacaoController.Modo.
-->
<Pane prefWidth="1440.0" prefHeight="1100.0"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.insidebank.controller.ValorTransacaoController"
      style="-fx-background-color: rgba(0,0,0,0.5);">

    <Pane layoutX="480" layoutY="292" prefWidth="480" prefHeight="440"
          style="-fx-background-color:black; -fx-background-radius:20; -fx-border-color:#303030; -fx-border-radius:20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.33), 20, 0, 0, 8);"/>

    <Button fx:id="btnFechar" layoutX="1001" layoutY="57" prefWidth="52" prefHeight="52" onAction="#onFechar"
        style="-fx-background-color:#191919; -fx-background-radius:26; -fx-cursor:hand;">
    <graphic><FontIcon iconLiteral="fth-x" iconSize="20" iconColor="white"/></graphic>
</Button>

    <VBox layoutX="480" layoutY="332" prefWidth="480" alignment="CENTER" spacing="10">
        <FontIcon fx:id="iconeModo" iconLiteral="fth-download" iconSize="34" iconColor="#FFF853"/>
        <Label fx:id="lblTitulo" text="Depositar" style="-fx-text-fill:white; -fx-font-size:22px;" styleClass="text-semibold"/>
        <Label text="Conta de teste - sem limite de valor" style="-fx-text-fill:rgba(255,255,255,0.4); -fx-font-size:13px;"/>
    </VBox>

    <Label text="Valor" styleClass="text-body" layoutX="520" layoutY="452"/>
    <TextField fx:id="txtValor" promptText="0,00" styleClass="input-field"
               style="-fx-font-size:28px; -fx-alignment:center;"
               layoutX="520" layoutY="480" prefWidth="400" prefHeight="64"/>

    <Label fx:id="lblErro" layoutX="520" layoutY="556" prefWidth="400" alignment="CENTER"
           style="-fx-text-fill:#FF6B6B; -fx-font-size:13px; -fx-text-alignment:center;"
           visible="false" managed="false"/>

    <Button fx:id="btnConfirmar" text="Depositar" styleClass="btn-primary" onAction="#onConfirmar"
            layoutX="520" layoutY="600" prefWidth="400" prefHeight="60" style="-fx-font-size:16px;"/>

</Pane>
