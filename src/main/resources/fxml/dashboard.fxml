            </StackPane>
            <Label text="Visao Geral" styleClass="text-label" style="-fx-padding: 20 0 0 0;"/>
            <HBox spacing="30" style="-fx-padding: 8 0 0 0;">
                <VBox spacing="4">
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <Pane prefWidth="10" prefHeight="10" style="-fx-background-radius:5; -fx-background-color:#526EFF;"/>
                        <Label text="Servicos" styleClass="text-small"/>
                    </HBox>
                    <Label text="R$ 1.144,81" styleClass="text-body" style="-fx-font-size:18px;"/>
                    <Pane prefWidth="396" prefHeight="8" styleClass="progress-fill-blue"/>
                </VBox>
                <VBox spacing="4">
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <Pane prefWidth="10" prefHeight="10" style="-fx-background-radius:5; -fx-background-color:#8E67FF;"/>
                        <Label text="Contas" styleClass="text-small"/>
                    </HBox>
                    <Label text="R$ 578,43" styleClass="text-body" style="-fx-font-size:18px;"/>
                    <Pane prefWidth="195" prefHeight="8" styleClass="progress-fill-purple"/>
                </VBox>
                <VBox spacing="4">
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <Pane prefWidth="10" prefHeight="10" style="-fx-background-radius:5; -fx-background-color:#C261FE;"/>
                        <Label text="Produtos" styleClass="text-small"/>
                    </HBox>
                    <Label text="R$ 544,00" styleClass="text-body" style="-fx-font-size:18px;"/>
                    <Pane prefWidth="187" prefHeight="8" styleClass="progress-fill-magenta"/>
                </VBox>
                <VBox spacing="4">
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <Pane prefWidth="10" prefHeight="10" style="-fx-background-radius:5; -fx-background-color:rgba(255,255,255,0.4);"/>
                        <Label text="Outros" styleClass="text-small"/>
                    </HBox>
                    <Label text="R$ 35,18" styleClass="text-body" style="-fx-font-size:18px;"/>
                    <Pane prefWidth="16" prefHeight="8" styleClass="progress-track"/>
                </VBox>
            </HBox>
        </VBox>
    </StackPane>
    <Button text="Esse mes" styleClass="btn-glass-pill"
            layoutX="1259" layoutY="219" prefWidth="120" prefHeight="38"/>

    <!-- ===== Acesso Rapido ===== -->
    <Label text="Acesso Rapido" styleClass="text-section-title" layoutX="129" layoutY="543"/>

    <VBox layoutX="130" layoutY="573" prefWidth="190" prefHeight="112" styleClass="btn-quick-action-highlight"
          alignment="CENTER" spacing="6" onMouseClicked="#onNavTransferir">
        <FontIcon iconLiteral="fth-send" iconSize="22"/>
        <Label text="Transferir via Pix" styleClass="text-body" style="-fx-font-size:14px;"/>
    </VBox>

    <HBox layoutX="130" layoutY="698" spacing="12" alignment="CENTER" prefWidth="190">
        <VBox prefWidth="90" prefHeight="100" styleClass="btn-quick-action"
              alignment="CENTER" spacing="6" onMouseClicked="#onNavDeposito">
            <FontIcon iconLiteral="fth-download" iconSize="22"/>
            <Label text="Deposito" styleClass="text-body" style="-fx-font-size:14px;"/>
        </VBox>
        <VBox prefWidth="90" prefHeight="100" styleClass="btn-quick-action"
              alignment="CENTER" spacing="6" onMouseClicked="#onNavSacar">
            <FontIcon iconLiteral="fth-minus-circle" iconSize="22"/>
            <Label text="Sacar" styleClass="text-body" style="-fx-font-size:14px;"/>
        </VBox>
    </HBox>

    <!-- ===== Cartoes (placeholders - substituir por imagens reais, ver ASSETS_TODO.md) ===== -->
    <StackPane layoutX="360" layoutY="573" prefWidth="388" prefHeight="225"
               style="-fx-background-radius:20; -fx-border-color: rgba(255,255,255,0.4); -fx-border-radius:20; -fx-background-color: linear-gradient(to bottom right, -gold-start, -gold-end);"
               alignment="CENTER">
        <VBox alignment="CENTER" spacing="4" prefWidth="340">
            <Label text="InsideBank" styleClass="text-semibold text-body" style="-fx-font-size:16px;"/>
            <Label text="NOME DO USUARIO" styleClass="text-body" style="-fx-font-size:14px;"/>
            <Label text="**** **** **** 8888" styleClass="text-semibold text-body" style="-fx-font-size:20px;"/>
        </VBox>
    </StackPane>
    <StackPane layoutX="760" layoutY="573" prefWidth="388" prefHeight="225"
               style="-fx-background-radius:20; -fx-background-color: linear-gradient(to bottom right, #a4a4a4, #232323); -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius:20;"
               alignment="CENTER">
        <VBox alignment="CENTER" spacing="4" prefWidth="340">
            <Label text="InsideBank" styleClass="text-semibold text-body" style="-fx-font-size:16px;"/>
            <Label text="NOME DO USUARIO" styleClass="text-body" style="-fx-font-size:14px;"/>
            <Label text="**** **** **** 8888" styleClass="text-semibold text-body" style="-fx-font-size:20px;"/>
        </VBox>
    </StackPane>

    <!-- ===== Cards promocionais ===== -->
    <StackPane layoutX="129" layoutY="875" prefWidth="416" prefHeight="212" styleClass="card, card-strong-border"
               style="-fx-background-color: linear-gradient(to left, rgba(252,246,27,0), #FCF61B);" alignment="TOP_LEFT">
        <VBox spacing="6"><padding><Insets top="58" left="24" right="24"/></padding>
            <Label text="Torne-se um Insider" style="-fx-text-fill:black; -fx-font-size:20px;" styleClass="text-semibold"/>
            <Label text="Adquira recursos imperdiveis com o programa Insider, como aumento do CDB, entre outros."
                   style="-fx-text-fill:black;" wrapText="true" prefWidth="208"/>
            <Label text="Saiba Mais &gt;" style="-fx-text-fill:black;" styleClass="text-medium"/>
        </VBox>
    </StackPane>
    <StackPane layoutX="560" layoutY="875" prefWidth="416" prefHeight="212" styleClass="card, card-strong-border"
               style="-fx-background-color: linear-gradient(to left, rgba(79,198,213,0), #4FC6D5);" alignment="TOP_LEFT">
        <VBox spacing="6"><padding><Insets top="58" left="24" right="24"/></padding>
            <Label text="Pub" style="-fx-text-fill:white; -fx-font-size:8px; -fx-background-color:black; -fx-padding:2 6 2 6; -fx-background-radius:4;"/>
            <Label text="Cashback Exclusivo" style="-fx-text-fill:black; -fx-font-size:20px;" styleClass="text-semibold"/>
            <Label text="Descontos imperdiveis de produtos na loja MagalineZuiza"
                   style="-fx-text-fill:black;" wrapText="true" prefWidth="208"/>
            <Label text="Saiba Mais &gt;" style="-fx-text-fill:black;" styleClass="text-medium"/>
        </VBox>
    </StackPane>
    <StackPane layoutX="991" layoutY="875" prefWidth="416" prefHeight="212" styleClass="card, card-strong-border"
               style="-fx-background-color: linear-gradient(to left, rgba(150,35,38,0), #962326);" alignment="TOP_LEFT">
        <VBox spacing="6"><padding><Insets top="58" left="24" right="24"/></padding>
            <Label text="Pub" style="-fx-text-fill:white; -fx-font-size:8px; -fx-background-color:black; -fx-padding:2 6 2 6; -fx-background-radius:4;"/>
            <Label text="Cashback Exclusivo" style="-fx-text-fill:black; -fx-font-size:20px;" styleClass="text-semibold"/>
            <Label text="Descontos imperdiveis de produtos na loja Europas"
                   style="-fx-text-fill:black;" wrapText="true" prefWidth="208"/>
            <Label text="Saiba Mais &gt;" style="-fx-text-fill:black;" styleClass="text-medium"/>
        </VBox>
    </StackPane>

</Pane>
