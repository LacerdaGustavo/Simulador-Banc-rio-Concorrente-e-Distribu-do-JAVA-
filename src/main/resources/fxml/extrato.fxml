<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!--
  Modal de Extrato (Figma node 202:6063 "Group 60", dentro do frame
  "Dashboard | Extrato" 202:5883). Coordenadas exatas obtidas via
  get_metadata: card em (356,35,728,960), titulo "Extrato Bancario" em
  (620,68), lista de linhas de movimentacao comecando em x=398 com 64px
  de altura cada e ~112px de espacamento entre o inicio de uma linha e a
  proxima. As linhas do Figma sao estaticas ("Pix Enviado"/"Pix Recebido"/
  "Compra aprovada" com valores fixos); aqui elas sao geradas dinamicamente
  a partir do historico real da conta (comando EXTRATO).
-->
<Pane prefWidth="1440.0" prefHeight="1100.0"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.insidebank.controller.ExtratoController"
      style="-fx-background-color: rgba(0,0,0,0.5);">

    <Pane layoutX="356" layoutY="35" prefWidth="728" prefHeight="960"
          style="-fx-background-color:black; -fx-background-radius:20; -fx-border-color:#303030; -fx-border-radius:20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.33), 20, 0, 0, 8);"/>

    <Button fx:id="btnFechar" layoutX="1001" layoutY="57" prefWidth="52" prefHeight="52" onAction="#onFechar"
        style="-fx-background-color:#191919; -fx-background-radius:26; -fx-cursor:hand;">
    <graphic><FontIcon iconLiteral="fth-x" iconSize="20" iconColor="white"/></graphic>
</Button>

    <Label text="Extrato Bancario" layoutX="356" layoutY="68" prefWidth="728" alignment="CENTER"
           style="-fx-text-alignment:center; -fx-font-size:22px; -fx-text-fill:white;"/>

    <ScrollPane layoutX="398" layoutY="118" prefWidth="638" prefHeight="857"
                style="-fx-background-color:transparent; -fx-background:transparent;" fitToWidth="true">
        <VBox fx:id="listaMovimentacoes" spacing="24" style="-fx-padding: 0 10 20 0;"/>
    </ScrollPane>

</Pane>
