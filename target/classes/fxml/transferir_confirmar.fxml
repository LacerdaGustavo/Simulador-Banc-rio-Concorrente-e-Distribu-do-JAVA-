<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!--
  Modal 2/3 do fluxo de Transferencia (Figma node 190:1342 "Confirmar transferencia").
-->
<Pane prefWidth="1440.0" prefHeight="1100.0"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.insidebank.controller.TransferirConfirmarController"
      style="-fx-background-color: rgba(0,0,0,0.5);">

    <Pane layoutX="356" layoutY="35" prefWidth="728" prefHeight="960"
          style="-fx-background-color:black; -fx-background-radius:20; -fx-border-color:#303030; -fx-border-radius:20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.33), 20, 0, 0, 8);"/>

    <Button layoutX="1001" layoutY="57" prefWidth="52" prefHeight="52" onAction="#onCancelar"
            style="-fx-background-color:#191919; -fx-background-radius:26; -fx-cursor:hand;">
        <graphic><FontIcon iconLiteral="fth-x" iconSize="20" iconColor="white"/></graphic>
    </Button>

    <Label text="Confirmar transferencia" layoutX="356" layoutY="70" prefWidth="728" alignment="CENTER"
           style="-fx-text-alignment:center; -fx-font-size:24px; -fx-text-fill:white;"/>

    <ScrollPane layoutX="356" layoutY="120" prefWidth="728" prefHeight="835"
                style="-fx-background-color:transparent; -fx-background:transparent;" fitToWidth="true"
                hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
        <content>
            <VBox prefWidth="728" spacing="24" alignment="CENTER"
                  style="-fx-padding:50 45 55 45; -fx-background-color:transparent;">

                <VBox spacing="10" alignment="CENTER">
                    <Pane prefWidth="96" prefHeight="96"
                          style="-fx-background-color: linear-gradient(to bottom right, -gold-start, -gold-end); -fx-background-radius:100;"/>
                    <Label fx:id="lblNomeDestino" text="Carregando..." style="-fx-text-fill:white; -fx-font-size:22px;" styleClass="text-semibold"/>
                    <Label fx:id="lblContaDestino" text="Conta" style="-fx-text-fill:rgba(255,255,255,0.4); -fx-font-size:16px;"/>
                </VBox>

                <VBox spacing="6" alignment="CENTER">
                    <Label text="Valor a transferir" style="-fx-text-fill:rgba(255,255,255,0.4); -fx-font-size:16px;"/>
                    <Label fx:id="lblValor" text="R$ 0,00" style="-fx-text-fill:white; -fx-font-size:48px;" styleClass="text-semibold"/>
                </VBox>

                <Label fx:id="lblErro" prefWidth="638" alignment="CENTER"
                       style="-fx-text-fill:#FF6B6B; -fx-font-size:14px; -fx-text-alignment:center;"
                       visible="false" managed="false"/>

                <Button fx:id="btnConfirmar" text="Confirmar Transferencia" styleClass="btn-primary" onAction="#onConfirmar"
                        prefWidth="638" prefHeight="70" style="-fx-font-size:18px;"/>
                <Button text="Cancelar" styleClass="btn-glass" onAction="#onCancelar"
                        prefWidth="638" prefHeight="60"/>

            </VBox>
        </content>
    </ScrollPane>

</Pane>
