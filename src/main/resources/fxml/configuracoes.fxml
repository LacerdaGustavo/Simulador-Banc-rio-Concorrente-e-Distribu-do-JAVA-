<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!--
  Tela de Configuracoes. O node "Configuracoes | Tema Claro" (202:5169) foi
  extraido do Figma (nav em pills: Geral / Minha Conta / Privacidade e
  Seguranca / Central de Ajuda), mas os demais nodes de Configuracoes nao
  puderam ser re-extraidos nesta sessao (limite do MCP do Figma). O painel
  "Geral" segue fielmente o padrao ja extraido (toggle de tema); os demais
  paineis sao versoes funcionais simplificadas, no mesmo design system.
-->
<Pane prefWidth="1440.0" prefHeight="1024.0"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.insidebank.controller.ConfiguracoesController">

    <VBox layoutX="18" layoutY="15" prefWidth="72" prefHeight="995"
          styleClass="sidebar" alignment="TOP_CENTER" spacing="18">
        <padding><Insets top="24" bottom="24"/></padding>
        <FontIcon iconLiteral="fth-credit-card" iconSize="26" iconColor="#FFF853"/>
        <Button styleClass="sidebar-icon-btn" onAction="#onVoltarDashboard">
            <graphic><FontIcon iconLiteral="fth-home" iconSize="20"/></graphic>
        </Button>
        <Button styleClass="sidebar-icon-btn">
            <graphic><FontIcon iconLiteral="fth-repeat" iconSize="20"/></graphic>
        </Button>
        <Button styleClass="sidebar-icon-btn" onAction="#onAbrirExtrato">
            <graphic><FontIcon iconLiteral="fth-list" iconSize="20"/></graphic>
        </Button>
        <Button styleClass="sidebar-icon-btn">
            <graphic><FontIcon iconLiteral="fth-pie-chart" iconSize="20"/></graphic>
        </Button>
        <Button styleClass="sidebar-icon-btn, sidebar-icon-btn-active">
            <graphic><FontIcon iconLiteral="fth-settings" iconSize="20"/></graphic>
        </Button>
        <Pane VBox.vgrow="ALWAYS"/>
        <Button styleClass="sidebar-icon-btn" onAction="#onVoltarDashboard">
            <graphic><FontIcon iconLiteral="fth-arrow-left" iconSize="20"/></graphic>
        </Button>
    </VBox>

    <Button layoutX="1001" layoutY="57" prefWidth="52" prefHeight="52" onAction="#onFechar"
        style="-fx-background-color:#191919; -fx-background-radius:26; -fx-cursor:hand;">
    <graphic><FontIcon iconLiteral="fth-x" iconSize="20" iconColor="white"/></graphic>
</Button>
    <Label text="Configuracoes" styleClass="text-section-title" layoutX="186" layoutY="70"/>

    <!-- Nav em pills (fiel ao node 202:5169) -->
    <VBox layoutX="130" layoutY="140" prefWidth="260" spacing="6">
        <Button fx:id="pillGeral" text="Geral" styleClass="nav-pill, nav-pill-active" prefWidth="260" prefHeight="48"
                onAction="#onMostrarGeral"/>
        <Button fx:id="pillMinhaConta" text="Minha Conta" styleClass="nav-pill" prefWidth="260" prefHeight="48"
                onAction="#onMostrarMinhaConta"/>
        <Button fx:id="pillPrivacidade" text="Privacidade e Seguranca" styleClass="nav-pill" prefWidth="260" prefHeight="48"
                onAction="#onMostrarPrivacidade"/>
        <Button fx:id="pillAjuda" text="Central de Ajuda" styleClass="nav-pill" prefWidth="260" prefHeight="48"
                onAction="#onMostrarAjuda"/>
    </VBox>

    <StackPane layoutX="420" layoutY="140" prefWidth="890" prefHeight="820">

        <!-- ===== Geral ===== -->
        <VBox fx:id="painelGeral" styleClass="card" spacing="24" visible="true" managed="true">
            <padding><Insets top="32" left="32" right="32" bottom="32"/></padding>
            <Label text="Geral" styleClass="text-section-title"/>
            <HBox spacing="20" alignment="CENTER_LEFT">
                <VBox HBox.hgrow="ALWAYS">
                    <Label text="Tema" styleClass="text-body" style="-fx-font-size:16px;"/>
                    <Label text="Escolha entre o tema escuro (padrao) e o claro." styleClass="text-small, text-muted"/>
                </VBox>
                <Button fx:id="btnTemaEscuro" text="Escuro" styleClass="btn-primary-pill" onAction="#onTemaEscuro"/>
                <Button fx:id="btnTemaClaro" text="Claro" styleClass="btn-glass-pill" onAction="#onTemaClaro"/>
            </HBox>
            <HBox spacing="20" alignment="CENTER_LEFT">
                <VBox HBox.hgrow="ALWAYS">
                    <Label text="Notificacoes" styleClass="text-body" style="-fx-font-size:16px;"/>
                    <Label text="Receber avisos de transacoes (recurso visual, sem backend ainda)." styleClass="text-small, text-muted"/>
                </VBox>
                <CheckBox styleClass="check-gold" selected="true"/>
            </HBox>
        </VBox>

        <!-- ===== Minha Conta ===== -->
        <VBox fx:id="painelMinhaConta" styleClass="card" spacing="18" visible="false" managed="false">
            <padding><Insets top="32" left="32" right="32" bottom="32"/></padding>
            <Label text="Minha Conta" styleClass="text-section-title"/>
            <VBox spacing="4">
                <Label text="Numero da conta" styleClass="text-small, text-muted"/>
                <Label fx:id="lblNumeroConta" text="--" styleClass="text-body" style="-fx-font-size:18px;"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Nome" styleClass="text-small, text-muted"/>
                <Label fx:id="lblNomeConta" text="--" styleClass="text-body" style="-fx-font-size:18px;"/>
            </VBox>
        </VBox>

        <!-- ===== Privacidade e Seguranca ===== -->
        <VBox fx:id="painelPrivacidade" styleClass="card" spacing="18" visible="false" managed="false">
            <padding><Insets top="32" left="32" right="32" bottom="32"/></padding>
            <Label text="Privacidade e Seguranca" styleClass="text-section-title"/>
            <Label wrapText="true" prefWidth="800" styleClass="text-body"
                   text="Troca de senha e autenticacao em duas etapas ainda nao foram implementadas no protocolo do servidor. Ver ROADMAP_TELAS.md para os proximos passos (hash de senha com jbcrypt ja esta no pom.xml, pronto para uso)."/>
        </VBox>

        <!-- ===== Central de Ajuda ===== -->
        <VBox fx:id="painelAjuda" styleClass="card" spacing="18" visible="false" managed="false">
            <padding><Insets top="32" left="32" right="32" bottom="32"/></padding>
            <Label text="Central de Ajuda" styleClass="text-section-title"/>
            <Label wrapText="true" prefWidth="800" styleClass="text-body"
                   text="Duvidas frequentes: Como faco login? Use o numero da conta e a senha cadastrados. Como transfiro dinheiro? Use o botao Transferir no Dashboard. Como falo com o suporte? Esta e uma versao academica de demonstracao, sem suporte real."/>
        </VBox>

    </StackPane>

</Pane>
