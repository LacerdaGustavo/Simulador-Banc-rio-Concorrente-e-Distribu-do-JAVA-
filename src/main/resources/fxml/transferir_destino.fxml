<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!--
  Modal 1/3 do fluxo de Transferencia (Figma node 190:714 "Transferir para").
  Adaptacao: o Figma usa uma "chave PIX" para o destinatario; como o protocolo
  do servidor (AtendimentoCliente.java) so entende banco+numero de conta, os
  campos abaixo pedem o banco e o numero da conta em vez da chave PIX.
  Os "atalhos" continuam apontando para as 3 contas de teste, que vivem
  fixas no Banco Alpha - por isso o atalho tambem seleciona esse banco.
-->
<Pane prefWidth="1440.0" prefHeight="1100.0"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.insidebank.controller.TransferirDestinoController"
      style="-fx-background-color: rgba(0,0,0,0.5);">

    <!-- Card (Figma: 356,35,728,960) -->
    <Pane layoutX="356" layoutY="35" prefWidth="728" prefHeight="960"
          style="-fx-background-color:black; -fx-background-radius:20; -fx-border-color:#303030; -fx-border-radius:20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.33), 20, 0, 0, 8);"/>

    <Button fx:id="btnFechar" layoutX="1001" layoutY="57" prefWidth="52" prefHeight="52" onAction="#onFechar"
        style="-fx-background-color:#191919; -fx-background-radius:26; -fx-cursor:hand;">
        <graphic><FontIcon iconLiteral="fth-x" iconSize="20" iconColor="white"/></graphic>
    </Button>

    <Label text="Transferir para" styleClass="text-body"
           layoutX="356" layoutY="56" prefWidth="728" alignment="CENTER"
           style="-fx-text-alignment:center; -fx-font-size:24px; -fx-text-fill:white;"/>

    <ScrollPane layoutX="356" layoutY="120" prefWidth="728" prefHeight="875"
                style="-fx-background-color:transparent; -fx-background:transparent;" fitToWidth="true"
                hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
        <content>
            <Pane prefWidth="728" prefHeight="869" style="-fx-background-color:transparent;">

                <!-- Campo Banco (novo) -->
                <Label text="Banco de destino" styleClass="text-body" layoutX="25" layoutY="0"/>
                <ComboBox fx:id="cmbBanco" promptText="Selecione o banco" styleClass="input-field"
                          layoutX="25" layoutY="29" prefWidth="678" prefHeight="60"/>

                <Label text="Numero da conta de destino" styleClass="text-body" layoutX="25" layoutY="89"/>
                <TextField fx:id="txtDestino" promptText="Ex: 1, 2 ou 3 (contas de teste)" styleClass="input-field"
                           layoutX="25" layoutY="118" prefWidth="678" prefHeight="60"/>

                <Label text="Atalho para as contas de teste (Banco Alpha)" styleClass="text-body" style="-fx-font-size:20px;"
                       layoutX="25" layoutY="204"/>

                <VBox layoutX="25" layoutY="244" spacing="8" alignment="CENTER" onMouseClicked="#onSelecionarConta1">
                    <Pane prefWidth="78.158" prefHeight="78.158"
                          style="-fx-background-color:#191919; -fx-border-color:#303030; -fx-background-radius:100; -fx-border-radius:100; -fx-cursor:hand;"/>
                    <Label text="Conta 1" style="-fx-text-fill:white; -fx-font-size:12px;"/>
                </VBox>
                <VBox layoutX="152" layoutY="244" spacing="8" alignment="CENTER" onMouseClicked="#onSelecionarConta2">
                    <Pane prefWidth="78.158" prefHeight="78.158"
                          style="-fx-background-color:#191919; -fx-border-color:#303030; -fx-background-radius:100; -fx-border-radius:100; -fx-cursor:hand;"/>
                    <Label text="Conta 2" style="-fx-text-fill:white; -fx-font-size:12px;"/>
                </VBox>
                <VBox layoutX="279" layoutY="244" spacing="8" alignment="CENTER" onMouseClicked="#onSelecionarConta3">
                    <Pane prefWidth="78.158" prefHeight="78.158"
                          style="-fx-background-color:#191919; -fx-border-color:#303030; -fx-background-radius:100; -fx-border-radius:100; -fx-cursor:hand;"/>
                    <Label text="Conta 3" style="-fx-text-fill:white; -fx-font-size:12px;"/>
                </VBox>

                <Label text="Valor da transferencia" styleClass="text-body" style="-fx-font-size:20px;"
                       layoutX="25" layoutY="374"/>
                <TextField fx:id="txtValor" promptText="0,00" styleClass="input-field"
                           style="-fx-font-size:32px; -fx-alignment:center;"
                           layoutX="25" layoutY="414" prefWidth="678" prefHeight="70"/>

                <Label fx:id="lblErro" layoutX="25" layoutY="504" prefWidth="678" alignment="CENTER"
                       style="-fx-text-fill:#FF6B6B; -fx-font-size:14px; -fx-text-alignment:center;"
                       visible="false" managed="false"/>

                <Button text="Transferir" styleClass="btn-primary" onAction="#onContinuar"
                        layoutX="25" layoutY="544" prefWidth="678" prefHeight="78" style="-fx-font-size:20px;"/>

            </Pane>
        </content>
    </ScrollPane>

</Pane>