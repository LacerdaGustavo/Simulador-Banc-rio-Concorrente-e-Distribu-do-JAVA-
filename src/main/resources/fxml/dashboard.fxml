<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<Pane fx:id="rootPane" prefWidth="1440.0" prefHeight="1100.0"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.insidebank.controller.DashboardController">

    <!-- ===== Sidebar (Figma: node "Sidebar" 34:9, 18,15,72,995) ===== -->
    <VBox layoutX="18" layoutY="15" prefWidth="72" prefHeight="995"
          styleClass="sidebar" alignment="TOP_CENTER" spacing="18">
        <padding><Insets top="24" bottom="24"/></padding>
        <FontIcon iconLiteral="fth-credit-card" iconSize="26" iconColor="#FFF853"/>
        <Button fx:id="btnNavHome" styleClass="sidebar-icon-btn, sidebar-icon-btn-active" onAction="#onNavHome">
            <graphic><FontIcon iconLiteral="fth-home" iconSize="20"/></graphic>
        </Button>
        <Button fx:id="btnNavTransferir" styleClass="sidebar-icon-btn" onAction="#onNavTransferir">
            <graphic><FontIcon iconLiteral="fth-repeat" iconSize="20"/></graphic>
        </Button>
        <Button fx:id="btnNavExtrato" styleClass="sidebar-icon-btn" onAction="#onNavExtrato">
            <graphic><FontIcon iconLiteral="fth-list" iconSize="20"/></graphic>
        </Button>
        <Button fx:id="btnNavConfiguracoes" styleClass="sidebar-icon-btn" onAction="#onNavConfiguracoes">
            <graphic><FontIcon iconLiteral="fth-settings" iconSize="20"/></graphic>
        </Button>
        
        <Button fx:id="btnNavSair" styleClass="sidebar-icon-btn" onAction="#onSair">
            <graphic><FontIcon iconLiteral="fth-log-out" iconSize="20"/></graphic>
        </Button>
    </VBox>

    <!-- ===== Topbar ===== -->
    <StackPane layoutX="822" layoutY="35" prefWidth="428.571" prefHeight="48" styleClass="search-container">
        <TextField fx:id="searchField" promptText="Buscar" styleClass="search-field" prefWidth="428.571" prefHeight="48"/>
        <FontIcon iconLiteral="fth-search" iconSize="16" styleClass="search-icon" StackPane.alignment="CENTER_LEFT" />
    </StackPane>
    <StackPane layoutX="1281" layoutY="35" prefWidth="48" prefHeight="48" styleClass="card">
        <FontIcon iconLiteral="fth-bell" iconSize="18"/>
    </StackPane>
    <StackPane fx:id="profileBtn" layoutX="1359" layoutY="35" prefWidth="48" prefHeight="48"
               style="-fx-background-radius:24; -fx-background-color: linear-gradient(to bottom right, -gold-start, -gold-end);"
               onMouseClicked="#onProfileClicked">
        <FontIcon iconLiteral="fth-user" iconSize="18" styleClass="profile-icon"/>
    </StackPane>

    <!-- ===== App Title ===== -->
    <Label text="InsideBank" styleClass="text-h1 text-semibold" layoutX="130" layoutY="90"/>

    <!-- ===== Titulo ===== -->
    <Label text="Visao Geral" styleClass="text-section-title" layoutX="130" layoutY="150"/>

    <!-- ===== Card Saldo (Figma: "Saldo" 75:7, 130,201,394,212) ===== -->
    <StackPane layoutX="130" layoutY="201" prefWidth="394" prefHeight="212" styleClass="card" alignment="TOP_LEFT">
        <VBox spacing="4">
            <padding><Insets top="36" left="29"/></padding>
            <Label text="Saldo em conta" styleClass="text-label"/>
            <Label fx:id="lblSaldo" text="R$ 0,00" styleClass="text-balance"/>
        </VBox>
    </StackPane>
    <Button text="Transferir" styleClass="btn-primary-pill" onAction="#onNavTransferir"
            layoutX="159" layoutY="339" prefWidth="162" prefHeight="39"/>
    <Button text="Ver Extrato" styleClass="btn-glass-pill" onAction="#onNavExtrato"
            layoutX="333" layoutY="339" prefWidth="162" prefHeight="39"/>

    <!-- ===== Receitas / Despesas ===== -->
    <StackPane layoutX="131" layoutY="427" prefWidth="190" prefHeight="80" styleClass="card" alignment="CENTER">
        <HBox spacing="12" alignment="CENTER">
            <FontIcon iconLiteral="fth-arrow-down-circle" iconSize="30" iconColor="#3DDC97"/>
            <VBox alignment="CENTER">
                <Label text="Receitas" styleClass="text-small, text-muted"/>
                <Label text="R$ 5.208" styleClass="text-medium text-amount" style="-fx-font-size:20px;"/>
            </VBox>
        </HBox>
    </StackPane>
    <StackPane layoutX="334" layoutY="427" prefWidth="190" prefHeight="80" styleClass="card" alignment="CENTER">
        <HBox spacing="12" alignment="CENTER">
            <FontIcon iconLiteral="fth-arrow-up-circle" iconSize="30" iconColor="#FF6B6B"/>
            <VBox alignment="CENTER">
                <Label text="Despesas" styleClass="text-small, text-muted"/>
                <Label text="R$ 2.302" styleClass="text-medium text-amount" style="-fx-font-size:20px;"/>
            </VBox>
        </HBox>
    </StackPane>

