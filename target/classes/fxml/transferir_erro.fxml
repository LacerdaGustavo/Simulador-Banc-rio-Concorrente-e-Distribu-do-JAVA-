<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!--
  Modal 3/3 do fluxo de Transferencia (Figma node 190:1150 "Transferencia invalida").
  Card menor e centralizado, seguindo o mesmo padrao visual dos outros modais.
-->
<Pane prefWidth="1440.0" prefHeight="1100.0"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.insidebank.controller.TransferirErroController"
      style="-fx-background-color: rgba(0,0,0,0.5);">

    <Pane layoutX="480" layoutY="352" prefWidth="480" prefHeight="320"
          style="-fx-background-color:black; -fx-background-radius:20; -fx-border-color:#303030; -fx-border-radius:20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.33), 20, 0, 0, 8);"/>

    <VBox layoutX="480" layoutY="392" prefWidth="480" alignment="CENTER" spacing="14">
        <FontIcon iconLiteral="fth-alert-triangle" iconSize="40" iconColor="#FF6B6B"/>
        <Label text="Transferencia invalida" style="-fx-text-fill:white; -fx-font-size:20px;" styleClass="text-semibold"/>
        <Label fx:id="lblMensagem" text="Nao foi possivel completar a transferencia." wrapText="true"
               style="-fx-text-fill:rgba(255,255,255,0.6); -fx-font-size:14px; -fx-text-alignment:center;"
               prefWidth="380" alignment="CENTER"/>
    </VBox>

    <Button text="Fechar" styleClass="btn-primary" onAction="#onFechar"
            layoutX="520" layoutY="592" prefWidth="400" prefHeight="56"/>

</Pane>
