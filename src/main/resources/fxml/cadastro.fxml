<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!--
  Tela: Cadastrar-se. Os nodes "Cadastrar | 1" (131:93) e "Cadastrar | 2"
  (131:147) nao puderam ser re-extraidos nesta sessao (limite do MCP do
  Figma). Construida reaproveitando exatamente o mesmo layout/coordenadas
  do node de Login ja extraido (115:2), trocando os campos de formulario -
  e a hipotese mais segura de fidelidade visual sem o node exato em maos.
-->
<Pane prefWidth="1440.0" prefHeight="1024.0"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.insidebank.controller.CadastroController">

    <FontIcon iconLiteral="fth-credit-card" iconSize="24" iconColor="WHITE"
              layoutX="65" layoutY="150"/>
    <Label text="InsideBank" styleClass="text-display" style="-fx-font-size:22px;"
           layoutX="97" layoutY="140"/>

    <Label text="Crie sua Conta" styleClass="text-display, text-h1"
           layoutX="65" layoutY="196"/>

    <StackPane layoutX="720" layoutY="46" prefWidth="678" prefHeight="932"
               style="-fx-background-color: linear-gradient(to bottom right, rgba(255,248,83,0.15), rgba(0,0,0,0.4)); -fx-background-radius:24;">
        <FontIcon iconLiteral="fth-user-plus" iconSize="64" iconColor="rgba(255,255,255,0.25)"/>
    </StackPane>

    <Label text="Nome completo" styleClass="text-body" layoutX="65" layoutY="270"/>
    <TextField fx:id="txtNome" promptText="Digite o seu nome" styleClass="input-field"
               layoutX="65" layoutY="298" prefWidth="580" prefHeight="60"/>

    <Label text="Senha" styleClass="text-body" layoutX="65" layoutY="374"/>
    <PasswordField fx:id="txtSenha" promptText="Crie uma senha" styleClass="input-field"
                   layoutX="65" layoutY="402" prefWidth="580" prefHeight="60"/>

    <Label text="Confirmar Senha" styleClass="text-body" layoutX="65" layoutY="478"/>
    <PasswordField fx:id="txtConfirmarSenha" promptText="Repita a senha" styleClass="input-field"
                   layoutX="65" layoutY="506" prefWidth="580" prefHeight="60"/>

    <Label fx:id="lblErro" styleClass="text-small" style="-fx-text-fill:#FF6B6B;"
           layoutX="65" layoutY="573" prefWidth="580" visible="false" managed="false"/>

    <Button fx:id="btnCriarConta" text="Criar Conta" styleClass="btn-primary" onAction="#onCriarConta"
            layoutX="65" layoutY="606" prefWidth="580" prefHeight="60"/>

    <Label styleClass="text-small, text-muted" wrapText="true"
           layoutX="65" layoutY="680" prefWidth="580" alignment="CENTER" style="-fx-text-alignment:center;"
           text="Ao criar uma conta, voce concorda com nossos Termos de Servico e Politica de Privacidade"/>

    <Button text="Ja tenho conta - Entrar" styleClass="btn-glass" onAction="#onJaTenhoConta"
            layoutX="65" layoutY="752" prefWidth="580" prefHeight="60"/>

    <Label text="Todos os direitos reservados. (c) InsideBank 2024"
           styleClass="text-small, text-muted"
           layoutX="65" layoutY="963" prefWidth="580" alignment="CENTER" style="-fx-text-alignment:center;"/>

</Pane>
