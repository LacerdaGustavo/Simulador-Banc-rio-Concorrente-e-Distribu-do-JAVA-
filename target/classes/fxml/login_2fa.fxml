<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!--
  Tela: Login | 2FA (Figma node 131:55, nao re-extraido nesta sessao por
  causa do limite do MCP). Como o servidor nao tem infraestrutura real de
  SMS/e-mail, o codigo de verificacao e' gerado localmente e mostrado na
  propria tela (rotulado como "modo demonstracao") - simulacao adequada
  para fins academicos, documentada em ROADMAP_TELAS.md.
-->
<Pane prefWidth="1440.0" prefHeight="1024.0"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.insidebank.controller.Login2FAController">

    <HBox alignment="CENTER" spacing="10" layoutX="65" layoutY="120" prefHeight="32">
        <FontIcon iconLiteral="fth-credit-card" iconSize="24" iconColor="WHITE"/>
        <Label text="InsideBank" styleClass="text-display" style="-fx-font-size:22px;"/>
    </HBox>

    <Label text="Verificacao em Duas Etapas" styleClass="text-display, text-h1"
           layoutX="65" layoutY="196"/>
    <Label text="Por seguranca, confirme o codigo abaixo para continuar." styleClass="text-body, text-muted"
           layoutX="65" layoutY="260" prefWidth="580" wrapText="true"/>

    <StackPane layoutX="720" layoutY="46" prefWidth="678" prefHeight="932"
               style="-fx-background-color: linear-gradient(to bottom right, rgba(255,248,83,0.15), rgba(0,0,0,0.4)); -fx-background-radius:24;">
        <ImageView fitWidth="678" fitHeight="932" preserveRatio="false">
            <image>
                <Image url="@../images/Rectangle%207.png"/>
            </image>
        </ImageView>
    </StackPane>

    <Pane layoutX="65" layoutY="330" prefWidth="580" prefHeight="90" styleClass="card">
        <Label text="Codigo de demonstracao (nao ha SMS/e-mail real neste projeto academico):"
               styleClass="text-small, text-muted" wrapText="true" layoutX="20" layoutY="14" prefWidth="540"/>
        <Label fx:id="lblCodigoDemo" text="000000" style="-fx-text-fill:#FFF853; -fx-font-size:28px;"
               styleClass="text-semibold" layoutX="20" layoutY="46"/>
    </Pane>

    <Label text="Digite o codigo recebido" styleClass="text-body" layoutX="65" layoutY="446"/>
    <TextField fx:id="txtCodigo" promptText="000000" styleClass="input-field"
               style="-fx-font-size:24px; -fx-alignment:center;"
               layoutX="65" layoutY="474" prefWidth="580" prefHeight="60"/>

    <Label fx:id="lblErro" styleClass="text-small" style="-fx-text-fill:#FF6B6B;"
           layoutX="65" layoutY="541" prefWidth="580" visible="false" managed="false"/>

    <Button fx:id="btnVerificar" text="Verificar e Entrar" styleClass="btn-primary" onAction="#onVerificar"
            layoutX="65" layoutY="574" prefWidth="580" prefHeight="60"/>

    <Button text="Cancelar e voltar ao Login" styleClass="btn-glass" onAction="#onCancelar"
            layoutX="65" layoutY="646" prefWidth="580" prefHeight="60"/>

</Pane>
